# Copy to .env and fill in real values. Never commit .env.

# --- LLM (Groq, OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Messaging (iMessage) ---
MESSAGING_PROVIDER=sendblue
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Dedicated Sendblue sending number for the agent, E.164
SENDBLUE_FROM_NUMBER=
# The only sender the agent responds to, E.164
ALLOWLISTED_PHONE=
WEBHOOK_SHARED_SECRET=

# --- Storage / scheduling ---
DATABASE_URL=sqlite:///./restaurant_agent.db
TIMEZONE=America/Los_Angeles
MONITOR_CRON_HOUR=9

# --- Restaurants / availability ---
RESTAURANTS_CONFIG=./restaurants.yaml
AVAILABILITY_FALLBACK_PLAYWRIGHT=true

LOG_LEVEL=INFO
